import { createFileRoute, redirect } from '@tanstack/react-router'
import { canAt } from '@shared/permissions.ts'
import { {{Pascal}}Page } from '../{{id}}-page.tsx'
import { {{camel}}Query } from '../queries.ts'

export const Route = createFileRoute('/_app/{{id}}')({
  beforeLoad: ({ context }) => {
    if (!canAt(context.user, '{{id}}', 'read')) throw redirect({ to: '/' })
  },
  loader: ({ context }) => context.queryClient.ensureQueryData({{camel}}Query),
  component: {{Pascal}}Page,
})
