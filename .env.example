# Copy to .env for local development. In Docker, set these in docker-compose.yml.

# Where the SQLite file lives. Mount this directory as a volume in production.
DATA_DIR=./data

# API port (the Vite dev server proxies /api to this).
PORT=3000

# Set to true when the app is served over HTTPS (reverse proxy). Plain HTTP on the
# office LAN needs false or the browser will refuse to store the session cookie.
COOKIE_SECURE=false

# Hours a signed-in session stays valid without activity.
SESSION_IDLE_HOURS=12

# First start only: the Super Admin created when the users table is empty.
# A one-time password is printed to the server log; it must be changed on first login.
BOOTSTRAP_ADMIN_EMAIL=admin@bphs.local
BOOTSTRAP_ADMIN_NAME=Super Admin
